{
    "schemaVersion": 1,
    "id": "simplecps",
    "version": "${version}",
    "name": "Eymistaken's HUD",
    "description": "A highly customizable HUD mod featuring multiple PvP modules and support for external plugins.",
    "authors": [
        "Eymistaken"
    ],
    "contact": {
        "homepage": "https://eymistaken.github.io/Eymistaken-s-HUD-Website/",
        "sources": "https://github.com/Eymistaken/SimpleCPS",
        "issues": "https://github.com/Eymistaken/SimpleCPS/issues"
    },
    "license": "MIT",
    "icon": "assets/simplecps/icon.png",
    "mixins": [
        "simplecps.mixins.json"
    ],
    "environment": "client",
    "entrypoints": {
        "main": [
            "com.eymistaken.simplecps.SimpleCPS"
        ],
        "client": [
            "com.eymistaken.simplecps.SimpleCPSClient"
        ],
        "modmenu": [
            "com.eymistaken.simplecps.ModMenuIntegration"
        ]
    },
    "depends": {
        "fabricloader": ">=0.18.4",
        "fabric-api": "*",
        "minecraft": ">=26.1 <26.2",
        "java": ">=25"
    },
    "suggests": {
        "cloth-config": "*",
        "modmenu": "*"
    }
}
