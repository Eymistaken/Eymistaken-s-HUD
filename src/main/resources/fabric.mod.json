    "description": "A simple, customizable CPS display mod for Fabric.",
    "authors": [
        "Eymistaken"
    ],
    "contact": {
        "homepage": "https://github.com/Eymistaken/SimpleCPS",
        "sources": "https://github.com/Eymistaken/SimpleCPS",
        "issues": "https://github.com/Eymistaken/SimpleCPS/issues"
    },
    "license": "MIT",
    "icon": "assets/simplecps/icon.png",
